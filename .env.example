# HTTP и уровень логов (logrus)
APP_PORT=8080
LOG_LEVEL=info

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5439
DB_NAME=bank-service

# Секреты
JWT_SECRET=
HMAC_SECRET=
PGP_PASSPHRASE=

# Кредит: ключевая ставка ЦБ + маржа в процентах (по умолчанию 5)
CBR_MARGIN_PERCENT=5

# SMTP (необязательные переменные, пустой SMTP_HOST отключает отправку писем)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
